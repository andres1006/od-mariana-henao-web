---
// Hero Section
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center bg-white overflow-hidden">
  <!-- Monograma MH de fondo sutil -->
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-0 opacity-[0.03]">
    <span class="text-[25rem] md:text-[35rem] lg:text-[45rem] font-bold text-gray-400">MH</span>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-screen py-20">
      
      <!-- Lado izquierdo - Texto principal -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Nombre principal -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-script text-[var(--color-primary)] mb-4" id="hero-name">
          Mariana Henao
        </h1>
        
        <!-- Profesión -->
        <p class="text-lg md:text-xl text-gray-600 mb-8" id="hero-profession">
          odontóloga
        </p>

        <!-- Call to action principal -->
        <div class="mb-8" id="hero-cta-section">
          <p class="text-xl md:text-2xl font-bold text-[var(--color-primary)] mb-2" id="hero-cta-1">
            CON NOSOTROS
          </p>
          <p class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--color-primary)] mb-3" id="hero-cta-2">
            DESCUBRE
          </p>
          <p class="text-xl md:text-2xl font-script text-[var(--color-accent)]" id="hero-cta-3">
            La mejor versión de ti
          </p>
        </div>

        <!-- Botón de contacto -->
        <div class="mb-6" id="hero-contact">
          <a 
            href="https://wa.me/573102608676"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-4 bg-[var(--color-primary)] text-white font-bold text-lg rounded-full hover:bg-[var(--color-primary-dark)] hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300 mb-4"
          >
            ¡Agenda tu cita!
          </a>
        </div>
      </div>

      <!-- Lado derecho - Imagen de la doctora -->
      <div class="text-center lg:text-right order-1 lg:order-2">
        <div class="relative max-w-lg mx-auto lg:mx-0 lg:ml-auto">
          <img 
            src="/images/Exports/silueta.png" 
            alt="Dra. Mariana Henao - Odontóloga profesional" 
            class="w-full h-auto max-w-md mx-auto lg:max-w-lg"
          />
          
          <!-- Información de contacto debajo de la imagen -->
          <div class="flex items-center justify-center lg:justify-end text-[var(--color-primary)] mt-6">
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
            </svg>
            <span class="text-xl font-bold">310 260 86 76</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha scroll down -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <div class="animate-bounce">
      <svg class="w-6 h-6 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .font-script {
    font-family: var(--font-script);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  #hero-name {
    animation: fadeInUp 1s ease-out 0.2s forwards;
    opacity: 0;
  }

  #hero-profession {
    animation: fadeInUp 1s ease-out 0.4s forwards;
    opacity: 0;
  }

  #hero-cta-1 {
    animation: fadeInLeft 1s ease-out 0.6s forwards;
    opacity: 0;
  }

  #hero-cta-2 {
    animation: fadeInLeft 1s ease-out 0.8s forwards;
    opacity: 0;
  }

  #hero-cta-3 {
    animation: fadeInLeft 1s ease-out 1s forwards;
    opacity: 0;
  }

  #hero-contact {
    animation: fadeInRight 1s ease-out 1.2s forwards;
    opacity: 0;
  }
</style>

