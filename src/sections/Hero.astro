---
// Hero Section
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Fondo con imagen -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent z-10"></div>
    <div class="w-full h-full bg-[var(--color-primary)] opacity-20"></div>
    <!-- Nota: Reemplazar con imagen real cuando esté disponible -->
    <!-- <img src="/images/hero-bg.jpg" alt="Mariana Henao" class="w-full h-full object-cover" /> -->
  </div>

  <!-- Monograma MH de fondo -->
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-0 opacity-5">
    <span class="text-[20rem] md:text-[30rem] font-bold text-[var(--color-bg-monogram)]">MH</span>
  </div>

  <!-- Contenido -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="hero-content">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6">
        <span class="block text-white uppercase tracking-wider mb-2" id="hero-text-1">
          CON NOSOTROS DESCUBRE
        </span>
        <span class="block font-script text-[var(--color-accent)] text-5xl sm:text-6xl md:text-7xl lg:text-8xl" id="hero-text-2">
          La mejor versión de ti
        </span>
      </h1>
      
      <p class="text-lg sm:text-xl md:text-2xl text-white/90 mb-8 max-w-2xl mx-auto" id="hero-description">
        Odontología especializada para una sonrisa saludable y hermosa
      </p>
      
      <a 
        href="#contacto"
        id="hero-cta"
        class="inline-block px-8 py-4 bg-[var(--color-primary)] text-white font-semibold text-lg rounded-full hover:bg-[var(--color-primary-dark)] hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300"
      >
        ¡Agenda tu cita ahora!
      </a>
    </div>
  </div>

  <!-- Flecha scroll down -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20">
    <div class="animate-bounce">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .font-script {
    font-family: var(--font-script);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-content > * {
    animation: fadeInUp 1s ease-out forwards;
  }

  #hero-text-1 {
    animation-delay: 0.2s;
    opacity: 0;
  }

  #hero-text-2 {
    animation-delay: 0.4s;
    opacity: 0;
  }

  #hero-description {
    animation-delay: 0.6s;
    opacity: 0;
  }

  #hero-cta {
    animation-delay: 0.8s;
    opacity: 0;
  }
</style>

