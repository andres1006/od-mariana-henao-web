---
// Services Section
---

<section id="servicios" class="bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center py-16 lg:py-20">
      
      <!-- Lado izquierdo - Servicios -->
      <div class="services-content order-2 lg:order-1">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--color-primary)] mb-8 lg:mb-12">
          Nuestros servicios
        </h2>
        
        <!-- Lista de servicios como pills -->
        <div class="space-y-3 lg:space-y-4">
          <div class="bg-[var(--color-primary)] text-white px-6 py-3 lg:px-8 lg:py-4 rounded-full text-lg lg:text-xl font-semibold hover:bg-[var(--color-primary-dark)] transition-colors duration-300 cursor-pointer text-center lg:text-left">
            Odontología preventiva
          </div>
          
          <div class="bg-[var(--color-primary)] text-white px-6 py-3 lg:px-8 lg:py-4 rounded-full text-lg lg:text-xl font-semibold hover:bg-[var(--color-primary-dark)] transition-colors duration-300 cursor-pointer text-center lg:text-left">
            Rehabilitación oral
          </div>
          
          <div class="bg-[var(--color-primary)] text-white px-6 py-3 lg:px-8 lg:py-4 rounded-full text-lg lg:text-xl font-semibold hover:bg-[var(--color-primary-dark)] transition-colors duration-300 cursor-pointer text-center lg:text-left">
            Estética dental
          </div>
          
          <div class="bg-[var(--color-primary)] text-white px-6 py-3 lg:px-8 lg:py-4 rounded-full text-lg lg:text-xl font-semibold hover:bg-[var(--color-primary-dark)] transition-colors duration-300 cursor-pointer text-center lg:text-left">
            Cirugía oral
          </div>
        </div>
      </div>

      <!-- Lado derecho - Imagen y CTA -->
      <div class="services-visual order-1 lg:order-2">
        <!-- Imagen de la doctora -->
        <div class="relative mb-6 lg:mb-8">
          <img 
            src="/images/Fotos/DSC_0179.JPG" 
            alt="Dra. Mariana Henao - Dentista profesional" 
            class="w-full h-[300px] lg:h-[400px] object-cover rounded-2xl shadow-2xl"
          />
        </div>
        
        <!-- CTA -->
        <div class="text-center">
          <p class="text-lg lg:text-2xl font-bold text-[var(--color-primary)] mb-4">¡Ven y renueva tu sonrisa!</p>
          <a 
            href="https://wa.me/573102608676"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 lg:px-8 lg:py-4 bg-[var(--color-primary)] text-white font-bold text-base lg:text-lg rounded-full hover:bg-[var(--color-primary-dark)] hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300"
          >
            Agenda tu cita ahora
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

