---
// Contact Section with Form and Map
---

<section id="contacto" class="relative overflow-hidden bg-white">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-28 left-24 h-64 w-64 rounded-full bg-[var(--color-primary)]/12 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-[var(--color-bg-light)]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr]">
      <div class="space-y-8">
        <div class="space-y-4">
          <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.32em] text-[var(--color-primary)]">
            Agenda tu valoración empática
          </span>
          <h2 class="text-3xl font-semibold text-[var(--color-text-dark)] sm:text-[2.5rem]">Conversemos sobre la sonrisa que sueñas.</h2>
          <p class="text-lg text-[var(--color-text-muted)]">
            Cuéntanos cuál es el cambio que deseas. Te contactaremos en menos de <strong class="font-semibold text-[var(--color-primary)]">2 horas</strong> por WhatsApp para agendar tu primera valoración y resolver tus dudas.
          </p>
        </div>

        <div class="rounded-3xl border border-[var(--color-primary)]/10 bg-[var(--color-bg-light)]/95 p-8 shadow-[0_32px_70px_-45px_rgba(15,30,32,0.35)]">
          <div class="flex items-center justify-between gap-4">
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[var(--color-primary)]">Paso a paso</p>
            <p id="contact-progress" class="text-xs font-medium text-[var(--color-text-muted)]">Paso 1 de 2</p>
          </div>
          <div class="mt-4 h-2 rounded-full bg-white/60">
            <div id="contact-progress-bar" class="h-full w-1/2 rounded-full bg-[var(--color-primary)] transition-all duration-300"></div>
          </div>

          <form id="contact-form" class="mt-6 space-y-8" novalidate>
            <div class="space-y-6" data-step="1">
              <div>
                <label for="nombre" class="block text-sm font-semibold text-[var(--color-text-dark)]">Nombre completo</label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  placeholder="Tu nombre"
                  autocomplete="name"
                  class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-base text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                />
              </div>
              <div>
                <label for="whatsapp" class="block text-sm font-semibold text-[var(--color-text-dark)]">WhatsApp</label>
                <input
                  id="whatsapp"
                  name="whatsapp"
                  type="tel"
                  required
                  inputmode="tel"
                  placeholder="310 260 86 76"
                  autocomplete="tel"
                  class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-base text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                />
                <p class="mt-2 text-xs text-[var(--color-text-muted)]">Te escribiremos primero por WhatsApp. No compartimos tu información con terceros.</p>
              </div>
              <button
                type="button"
                data-action="next"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white shadow-[0_22px_55px_-32px_rgba(0,168,157,0.8)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--color-primary-dark)]"
              >
                Continuar a tus objetivos
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 10h10" />
                  <path d="M10 5l5 5-5 5" />
                </svg>
              </button>
            </div>

            <div class="space-y-6 hidden" data-step="2">
              <div>
                <label for="email" class="block text-sm font-semibold text-[var(--color-text-dark)]">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="tu@email.com"
                  autocomplete="email"
                  class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-base text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                />
              </div>
              <div>
                <label for="mensaje" class="block text-sm font-semibold text-[var(--color-text-dark)]">¿Cuál es el mayor cambio que esperas en tu sonrisa?</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="4"
                  required
                  placeholder="Cuéntanos qué te incomoda hoy y cómo te gustaría sentirte..."
                  class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-base text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                ></textarea>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="preferencia" class="block text-sm font-semibold text-[var(--color-text-dark)]">¿Cómo prefieres que te contactemos?</label>
                  <select
                    id="preferencia"
                    name="preferencia"
                    class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-sm text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                  >
                    <option value="whatsapp">WhatsApp (respuesta en &lt;15 min)</option>
                    <option value="llamada">Llamada telefónica</option>
                    <option value="email">Email</option>
                  </select>
                </div>
                <div>
                  <label for="horario" class="block text-sm font-semibold text-[var(--color-text-dark)]">Horario ideal para tu cita</label>
                  <input
                    id="horario"
                    name="horario"
                    type="text"
                    placeholder="Ej: Entre 8:00 a.m. y 10:00 a.m."
                    class="mt-2 w-full rounded-2xl border border-white/70 bg-white px-4 py-3 text-sm text-[var(--color-text-dark)] shadow-sm transition focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/25"
                  />
                </div>
              </div>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <button
                  type="button"
                  data-action="back"
                  class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-primary)] transition-colors duration-300 hover:text-[var(--color-primary-dark)]"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 10H5" />
                    <path d="M10 5l-5 5 5 5" />
                  </svg>
                  Volver
                </button>
                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white shadow-[0_22px_55px_-30px_rgba(0,168,157,0.8)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--color-primary-dark)] sm:w-auto"
                >
                  Enviar y agendar por WhatsApp
                </button>
              </div>
            </div>
          </form>

          <div id="contact-success" class="mt-6 hidden rounded-2xl bg-white/90 px-5 py-4 text-sm text-[var(--color-text-dark)] shadow-sm" role="status" aria-live="polite">
            ¡Gracias por escribirnos! En breve recibirás un mensaje de nuestro equipo para coordinar tu valoración empática.
          </div>
        </div>

        <div class="space-y-4 rounded-3xl border border-[var(--color-primary)]/10 bg-white/95 p-6 shadow-sm">
          <p class="text-base font-semibold text-[var(--color-text-dark)]">¿Prefieres escribirnos directamente?</p>
          <a href="https://wa.me/573102608676" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 text-[var(--color-primary)] transition-colors duration-300 hover:text-[var(--color-primary-dark)]">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
            </svg>
            310 260 86 76 · Respuesta en menos de 15 minutos
          </a>
          <div class="text-sm text-[var(--color-text-muted)]">
            <p>Calle 64A No. 21 - 10 · Edificio Portal del Cable - Local 14 · Manizales</p>
            <p>Horario: Lun a Vie · 8:00 a.m. - 6:00 p.m.</p>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <details class="rounded-3xl border border-[var(--color-primary)]/10 bg-white/95 p-6 shadow-[0_28px_70px_-45px_rgba(15,30,32,0.35)]" open>
          <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-[var(--color-text-dark)]">
            Ubicación del consultorio
            <span class="text-sm font-medium text-[var(--color-primary)]">Ver mapa</span>
          </summary>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Calle 64A No. 21 - 10 · Edificio Portal del Cable - Local 14 · Manizales</p>
          <div class="mt-4 overflow-hidden rounded-2xl">
            <iframe
              title="Ubicación consultorio Mariana Henao"
              src="https://www.google.com/maps?q=Calle+64A+%2321-10,+Manizales,+Caldas&output=embed"
              class="h-[260px] w-full border-0 sm:h-[340px] lg:h-[420px]"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </details>

        <div class="rounded-3xl border border-[var(--color-primary)]/10 bg-[var(--color-bg-light)]/90 p-6 text-sm text-[var(--color-text-muted)] shadow-sm">
          <p class="font-semibold text-[var(--color-text-dark)]">¿Lista para reservar directamente?</p>
          <p class="mt-1">Pronto integraremos una agenda automática. Mientras tanto, nuestro equipo confirma tu cita en minutos.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form');
  const panels = contactForm?.querySelectorAll('[data-step]');
  const nextBtn = contactForm?.querySelector('[data-action="next"]');
  const backBtn = contactForm?.querySelector('[data-action="back"]');
  const progressLabel = document.getElementById('contact-progress');
  const progressBar = document.getElementById('contact-progress-bar');
  const successMessage = document.getElementById('contact-success');

  let currentStep = 1;

  const updateStepVisibility = () => {
    panels?.forEach((panel) => {
      const step = Number(panel.getAttribute('data-step'));
      if (step === currentStep) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    if (progressLabel) {
      progressLabel.textContent = `Paso ${currentStep} de 2`;
    }
    if (progressBar) {
      progressBar.style.width = currentStep === 1 ? '50%' : '100%';
    }
  };

  nextBtn?.addEventListener('click', () => {
    if (!contactForm) return;
    const stepOneFields = contactForm.querySelectorAll('[data-step="1"] input');
    for (const field of stepOneFields) {
      if (!(field).checkValidity()) {
        (field).reportValidity();
        return;
      }
    }
    if (successMessage) {
      successMessage.classList.add('hidden');
    }
    currentStep = 2;
    updateStepVisibility();
  });

  backBtn?.addEventListener('click', () => {
    if (successMessage) {
      successMessage.classList.add('hidden');
    }
    currentStep = 1;
    updateStepVisibility();
  });

  contactForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const fields = contactForm.querySelectorAll('input, textarea');
    for (const field of fields) {
      if (!(field).checkValidity()) {
        (field).reportValidity();
        return;
      }
    }
    contactForm.reset();
    currentStep = 1;
    updateStepVisibility();
    if (successMessage) {
      successMessage.classList.remove('hidden');
    }
    window.scrollTo({ top: contactForm.getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
  });

  updateStepVisibility();
</script>
