---
import ContactCard from '../components/ContactCard';
import { FaWhatsapp, FaInstagram, FaMapMarkerAlt } from 'react-icons/fa';
---

<section id="contacto" class="bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-primary-dark)] text-white relative overflow-hidden">
  <!-- Elementos decorativos -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Título -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4">
        ¿Lista para transformar tu sonrisa?
      </h2>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Contáctame y descubre cómo puedo ayudarte a lograr la sonrisa que siempre has soñado
      </p>
      <div class="w-24 h-1 bg-white/50 mx-auto rounded-full mt-6"></div>
    </div>

    <!-- Tarjetas de contacto -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <ContactCard 
        icon={<FaWhatsapp />}
        title="WhatsApp"
        content={
          <div>
            <p className="font-semibold text-lg">310 260 86 76</p>
            <p className="text-sm mt-2">Haz clic para chatear</p>
          </div>
        }
        link="https://wa.me/573102608676"
        delay={0.1}
        client:visible
      />
      
      <ContactCard 
        icon={<FaInstagram />}
        title="Instagram"
        content={
          <div>
            <p className="font-semibold text-lg">@od.mariana.henao</p>
            <p className="text-sm mt-2">Sígueme en redes</p>
          </div>
        }
        link="https://www.instagram.com/od.mariana.henao"
        delay={0.2}
        client:visible
      />
      
      <ContactCard 
        icon={<FaMapMarkerAlt />}
        title="Ubicación"
        content={
          <div>
            <p className="font-semibold">Calle 64A No. 21 - 10</p>
            <p className="text-sm">Edificio Portal del Cable</p>
            <p className="text-sm">Local 14, Manizales</p>
            <p className="text-sm mt-2">Ver en Google Maps</p>
          </div>
        }
        link="https://www.google.com/maps/search/?api=1&query=Calle+64A+No.+21+-+10+Edificio+Portal+del+Cable+Manizales"
        delay={0.3}
        client:visible
      />
    </div>

    <!-- CTA final -->
    <div class="text-center">
      <a 
        href="https://wa.me/573102608676"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-10 py-5 bg-white text-[var(--color-primary)] font-bold text-lg rounded-full hover:bg-[var(--color-bg-light)] hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300"
      >
        Agenda tu cita por WhatsApp
      </a>
    </div>
  </div>
</section>

