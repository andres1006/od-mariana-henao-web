---
// Testimonials Section
const testimonials = [
  {
    name: 'Laura Pérez',
    service: 'Diseño de sonrisa',
    quote:
      'Pasé de esconderme en las fotos a amar cada retrato. Jamás imaginé que sería tan cómodo y cero doloroso.',
    before: 'Se tapaba la boca en reuniones sociales',
    after: 'Hoy sonríe en cada foto y lidera presentaciones con seguridad',
  },
  {
    name: 'Daniela Rodríguez',
    service: 'Carillas personalizadas',
    quote:
      'Me hablaron con tanta claridad que dejé de sentir miedo. Cada sesión fue suave y llena de paciencia.',
    before: 'Desconfianza por experiencias negativas',
    after: 'Recuperó la tranquilidad y recibe cumplidos diarios',
  },
  {
    name: 'Marcela López',
    service: 'Manejo de bruxismo',
    quote:
      'Con la férula y las rutinas de relajación duermo profundo. Ya no me levanto con dolor de cabeza.',
    before: 'Dolor mandibular y cansancio matutino',
    after: 'Sueño reparador y energía para sus clases de yoga',
  },
  {
    name: 'Juliana Sánchez',
    service: 'Rehabilitación integral',
    quote:
      'Sentí que mi historia importaba. Me acompañaron en cada decisión y el resultado es totalmente natural.',
    before: 'Inseguridad al hablar en público',
    after: 'Confianza inquebrantable en eventos empresariales',
  },
];
---

<section id="testimonios" class="relative overflow-hidden bg-[var(--color-bg-soft)]">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-0 top-24 h-64 w-64 rounded-full bg-[var(--color-primary)]/10 blur-3xl"></div>
    <div class="absolute right-0 top-0 h-64 w-64 rounded-full bg-white/80 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center justify-center gap-2 rounded-full bg-white/90 px-4 py-2 text-xs font-semibold uppercase tracking-[0.32em] text-[var(--color-primary)]">
        Sus historias
      </span>
      <h2 class="mt-4 text-3xl font-semibold text-[var(--color-text-dark)] sm:text-[2.5rem]">
        Personas que recuperaron su confianza.
      </h2>
      <p class="mt-6 text-lg text-[var(--color-text-muted)]">
        Testimonios reales recopilados de Google Reviews, Doctoralia e Instagram. Historias de transformación emocional y clínica que nos inspiran a seguir acompañando con empatía.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-[var(--color-text-muted)]">
      <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm">
        <svg class="h-4 w-4 text-[#f7b733]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 15.27L16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
        </svg>
        5.0 ★ promedio en 180 reseñas verificadas
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm">
        <svg class="h-4 w-4 text-[var(--color-primary)]" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 8a4 4 0 1 0-4 4h4" />
          <path d="M12 8v8" />
        </svg>
        +540 acompañamientos completados
      </span>
    </div>

    <div
      class="mt-12 grid auto-cols-[85%] grid-flow-col gap-6 overflow-x-auto pb-8 pl-4 pr-8 snap-x snap-mandatory sm:auto-cols-[minmax(320px,1fr)] sm:pr-10 md:auto-cols-auto md:grid-cols-2 md:grid-flow-row md:overflow-visible md:pb-0 md:pl-0 md:pr-0 md:snap-none lg:grid-cols-3 xl:grid-cols-4"
      role="list"
      aria-label="Testimonios de pacientes"
    >
      {testimonials.map((testimonial) => (
        <article
          key={testimonial.name}
          role="listitem"
          class="flex h-full min-h-[360px] min-w-[78vw] snap-start flex-col justify-between rounded-3xl border border-[var(--color-primary)]/12 bg-white/95 p-8 shadow-[0_22px_55px_-42px_rgba(15,30,32,0.32)] transition-transform duration-300 hover:-translate-y-1 sm:min-w-[320px] md:min-h-0 md:min-w-0 md:justify-between md:hover:-translate-y-1.5"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-primary)]/12 text-base font-semibold text-[var(--color-primary)]">
                {testimonial.name
                  .split(' ')
                  .map((part) => part[0])
                  .join('')}
              </div>
              <div>
                <p class="text-sm font-semibold text-[var(--color-text-dark)]">{testimonial.name}</p>
                <p class="text-xs font-medium uppercase tracking-[0.22em] text-[var(--color-text-muted)]">{testimonial.service}</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-primary)]">
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 0l2.39 6.92L20 7.63l-5.2 4.68L16.18 20 10 16.45 3.82 20l1.38-7.69L0 7.63l7.61-.71L10 0z" />
              </svg>
              Verificado
            </span>
          </div>

          <blockquote class="mt-6 space-y-4 text-sm text-[var(--color-text-muted)]">
            <p class="text-base font-medium text-[var(--color-text-dark)]">“{testimonial.quote}”</p>
            <div class="rounded-2xl bg-[var(--color-bg-light)]/90 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">Antes → Después</p>
              <p class="mt-1 text-xs text-[var(--color-text-muted)]">{testimonial.before}</p>
              <p class="mt-1 text-xs font-medium text-[var(--color-text-dark)]">{testimonial.after}</p>
            </div>
          </blockquote>

          <a
            href="https://www.instagram.com/od.mariana.henao"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-xs font-semibold text-[var(--color-primary)] transition-colors duration-300 hover:text-[var(--color-primary-dark)]"
          >
            Ver historia completa
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 10h10" />
              <path d="M10 5l5 5-5 5" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
