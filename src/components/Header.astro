---
import MobileMenu from './MobileMenu';
---

<header id="header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-3" aria-label="Volver al inicio">
      <div class="flex flex-col leading-none">
        <span class="text-2xl font-semibold tracking-tight text-[var(--color-text-dark)] sm:text-[28px]">Mariana Henao</span>
        <span class="text-[11px] font-medium uppercase tracking-[0.32em] text-[var(--color-primary)] sm:text-xs">
          Odontóloga empática
        </span>
      </div>
    </a>

    <!-- Navegación Desktop -->
    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label="Secciones principales"
    >
      {['Inicio', '¿Te identificas?', 'La promesa', 'Servicios', 'Testimonios', 'Contacto'].map((label, index) => {
        const href = ['#inicio', '#dolor', '#promesa', '#servicios', '#testimonios', '#contacto'][index];
        return (
          <a
            href={href}
            class="group relative text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-300 hover:text-[var(--color-primary)]"
          >
            {label}
            <span
              class="absolute inset-x-0 -bottom-1 h-0.5 origin-left scale-x-0 rounded-full bg-[var(--color-primary)] transition-transform duration-300 group-hover:scale-x-100"
              aria-hidden="true"
            ></span>
          </a>
        );
      })}
    </nav>

    <a
      href="https://wa.me/573102608676"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden items-center gap-2 rounded-full bg-[var(--color-primary)] px-5 py-2.5 text-sm font-semibold text-white shadow-[0_10px_25px_-12px_rgba(0,168,157,0.7)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--color-primary-dark)] hover:shadow-[0_18px_30px_-12px_rgba(0,168,157,0.6)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:flex"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M8 2v4" />
        <path d="M16 2v4" />
        <rect x="3" y="5" width="18" height="17" rx="4" />
        <path d="M16 13h-4" />
        <path d="M12 17h-4" />
      </svg>
      Agenda tu valoración
    </a>

    <!-- Menú Móvil -->
    <MobileMenu client:load />
  </div>
</header>

<style>
  #header {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 30px rgba(22, 43, 43, 0.05);
  }

  #header.is-scrolled {
    box-shadow: 0 12px 32px rgba(22, 43, 43, 0.08);
    padding-block: 0.35rem;
  }

  @media (max-width: 1023px) {
    #header.is-scrolled {
      padding-block: 0.25rem;
    }
  }
</style>

<script>
  const header = document.getElementById('header');

  const toggleHeaderState = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', toggleHeaderState, { passive: true });
  toggleHeaderState();
</script>

